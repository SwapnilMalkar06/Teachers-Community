# ==============================================================================
# REAL-TIME SMS GATEWAY CONFIGURATION
# Set ONE of the following providers in your local .env to send live SMS to mobile numbers:
# ==============================================================================

# Option 1: Fast2SMS (India - Recommended for Quick Indian Mobile SMS)
# Get free API key from https://www.fast2sms.com
# FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# Option 2: 2Factor (India)
# TWOFACTOR_API_KEY="your_2factor_api_key_here"

# Option 3: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID="your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE_NUMBER="+1234567890"

# Option 4: Custom HTTP Webhook Gateway
# CUSTOM_SMS_URL="https://api.mysmsgateway.com/send?to={phone}&otp={otp}&msg=Your+OTP+is+{otp}"
